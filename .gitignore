# Provisioned ML models — downloaded at runtime, never committed
product/models/
*.onnx

# WP-088 canonical disposable build output and process temporary files
/build-artifacts/
# Retired defaults remain ignored for migration only; never build here.
/product/target/
/target/

# Legacy release paths remain ignored until package-release.ps1 migrates them.
/product/facial.exe
/product/archive/exe/
/product/facial.exe.sha256
/product/release-artifacts.sha256

# Current and archived delivery outputs (WP-059); installer source stays tracked.
/installer/facial-portable-*.exe
/installer/facial-setup-*.exe
/installer/installer-portable-archive/
/installer/payload/
/installer/out/

# Runtime outputs / working dirs
/worktrees/
/.facial/
/product/data/

# Local research clones and agent/editor state are not product source.
/_source_checks/
/.superpowers/
/.vscode/
/.idea/

# Machine-local secrets and operating-system clutter.
.env
.env.*
!.env.example
Thumbs.db
Desktop.ini
