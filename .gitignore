# Provisioned ML models — downloaded at runtime, never committed
product/models/
*.onnx

# Build artifacts (Cargo default, in-repo, disposable scratch)
product/target/

# Published and archived release binaries are generated by package-release.ps1.
# Keep the reproducible source and installer scripts in Git, not local binaries.
/product/facial.exe
/product/archive/exe/
/product/facial.exe.sha256
/product/release-artifacts.sha256

# Installer build outputs (WP-025) - source (.iss, .cmd) is tracked; outputs are not
/installer/out/
/installer/payload/

# Runtime outputs / working dirs
/worktrees/
/.facial/
/product/data/

# Local research clones and agent/editor state are not product source.
/_source_checks/
/.superpowers/
/.vscode/
/.idea/

# Machine-local secrets and operating-system clutter.
.env
.env.*
!.env.example
Thumbs.db
Desktop.ini
